{
  "name": "sih-26189-criminal",
  "version": "0.1.0",
  "private": true,
  "description": "SIH 26189 \u2013 Criminal: AI-driven Investigative Intelligence System",
  "scripts": {
    "dev": "pnpm --filter @sih/api dev",
    "build": "pnpm --filter @sih/shared build && pnpm --filter @sih/api build",
    "start": "pnpm --filter @sih/api start",
    "db:generate": "pnpm --filter @sih/api db:generate",
    "db:migrate": "pnpm --filter @sih/api db:migrate",
    "db:seed": "pnpm --filter @sih/api db:seed",
    "db:setup": "pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "test": "pnpm --filter @sih/shared build && pnpm --filter @sih/api test",
    "typecheck": "pnpm --filter @sih/shared build && pnpm --filter @sih/api typecheck",
    "demo:phase3": "pnpm --filter @sih/api demo:phase3",
    "demo:phase4": "pnpm --filter @sih/api demo:phase4",
    "demo:merged": "pnpm --filter @sih/api demo:merged"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
