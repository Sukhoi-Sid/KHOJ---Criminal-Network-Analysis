// SIH 26189 – Criminal | Phase 1 schema
// Source of truth: docs/implementation/IMPLEMENTATION-BLUEPRINT.md (§4, §5)
// Storage rule: PostgreSQL = operational + metadata. Evidence blob content lives on
// the filesystem (EVIDENCE_STORAGE_PATH); this schema stores only the index/metadata,
// per "Evidence Index" row in the Data Storage Responsibilities table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────

enum UserRole {
  investigator
  supervisor
  auditor
  admin
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdCases       Case[]                      @relation("CaseCreatedBy")
  caseAssignments    CaseAssignment[]
  uploadedDocuments  Document[]
  auditEvents        AuditEvent[]
  provenanceReceipts Provenance[]
  gapReviews         IntelligenceGap[]           @relation("GapReviewer")
  createdRequests    IntelligenceRequest[]       @relation("RequestCreator")
  authorizations     IntelligenceAuthorization[]
  requestTransitions IntelligenceTransition[]
  resolutionHistory  ResolutionHistory[]
  analysisRuns       AnalysisRun[]

  @@map("users")
}

// ─── Case Platform (Phase 1) ───────────────────────────────────────────────

enum CaseStatus {
  open
  active
  on_hold
  closed
}

enum CaseClassification {
  restricted
  confidential
  secret
}

enum CaseAssignmentRole {
  investigator
  supervisor
}

model Case {
  id             String             @id @default(uuid())
  caseId         String             @unique // human-readable ref, e.g. REF-2026-001
  title          String
  description    String?
  status         CaseStatus         @default(open)
  classification CaseClassification @default(restricted)
  jurisdiction   String?
  contextSummary String?
  createdById    String
  createdBy      User               @relation("CaseCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  assignments          CaseAssignment[]
  intelligenceState    CaseIntelligenceState?
  documents            Document[]
  evidenceRecords      EvidenceRecord[]
  mentions             Mention[]
  auditEvents          AuditEvent[]
  contextAnalysis      CaseContextAnalysis?
  intelligenceGaps     IntelligenceGap[]
  intelligenceRequests IntelligenceRequest[]
  normalizedRecords    NormalizedSourceRecord[]
  canonicalEntities    CanonicalEntity[]
  resolutionCandidates ResolutionCandidate[]
  resolutionHistory    ResolutionHistory[]
  relationships        DerivedRelationship[]
  graphSync            GraphSyncState?
  analysisRuns         AnalysisRun[]
  analyticalSignals    AnalyticalSignal[]
  brainEvents          BrainEvent[]

  @@map("cases")
}

model CaseAssignment {
  id        String             @id @default(uuid())
  caseId    String
  case      Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  role      CaseAssignmentRole
  createdAt DateTime           @default(now())

  @@unique([caseId, userId])
  @@map("case_assignments")
}

// Versioned, evolving summary of what the case "knows" so far. Owned by
// case-platform (blueprint §3). Body is a free-form JSON snapshot in Phase 1;
// later phases (brain, entity-resolution) write structured updates into it.
model CaseIntelligenceState {
  id        String   @id @default(uuid())
  caseId    String   @unique
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  version   Int      @default(1)
  summary   Json     @default("{}")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("case_intelligence_states")
}

// ─── Audit (cross-cutting, append-only) ────────────────────────────────────

enum AuditAction {
  login
  logout
  login_failed
  case_create
  case_read
  case_update
  case_assign
  evidence_document_create
  evidence_document_read
  document_process
  user_create
  user_update
  audit_read
  access_denied
  intelligence_analyze
  intelligence_read
  intelligence_review
  intelligence_request_create
  intelligence_transition
  entity_integrate
  entity_read
  entity_review
  graph_sync
  brain_analyze
  brain_read
}

enum AuditResourceType {
  user
  case
  document
  evidence
  audit
  session
  intelligence_gap
  intelligence_request
  canonical_entity
  resolution_candidate
  case_graph
  analytical_signal
}

model AuditEvent {
  id           String            @id @default(uuid())
  actorId      String?
  actor        User?             @relation(fields: [actorId], references: [id])
  actorEmail   String?
  action       AuditAction
  resourceType AuditResourceType
  resourceId   String?
  caseId       String?
  case         Case?             @relation(fields: [caseId], references: [id])
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime          @default(now())

  @@index([caseId])
  @@index([actorId])
  @@index([action])
  @@map("audit_events")
}

// ─── Evidence Store (skeleton — source of truth per SOURCE-OF-TRUTH.md #1) ─

enum EvidenceSourceType {
  fir_upload
  report_upload
  attachment
  external_package
}

enum ReliabilityTier {
  tier1_authoritative
  tier2_operational
  tier3_derived
  tier4_unverified
}

// Metadata/index record for an uploaded file. The blob itself is written to
// EVIDENCE_STORAGE_PATH on disk; only its pointer + hash live here.
model Document {
  id           String             @id @default(uuid())
  caseId       String
  case         Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  filename     String
  mimeType     String
  contentHash  String
  blobPath     String
  sizeBytes    Int
  sourceType   EvidenceSourceType
  uploadedById String
  uploadedBy   User               @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime           @default(now())

  // Phase 2 — document-intelligence processing state. Lives on Document
  // (not a separate 1:1 table) since it's simple per-document state, not an
  // independent entity with its own lifecycle beyond the document's.
  processingStatus DocumentProcessingStatus @default(pending)
  processingError  String?
  processedAt      DateTime?
  extractedPages   Json?

  evidenceRecords   EvidenceRecord[]
  mentions          Mention[]
  gapOrigins        IntelligenceGapOrigin[]
  normalizedRecords NormalizedSourceRecord[]

  @@index([caseId])
  @@map("documents")
}

model EvidenceRecord {
  id              String             @id @default(uuid())
  caseId          String
  case            Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  documentId      String?
  document        Document?          @relation(fields: [documentId], references: [id])
  sourceType      EvidenceSourceType
  sourceRecordId  String
  reliabilityTier ReliabilityTier    @default(tier1_authoritative)
  contentHash     String
  createdAt       DateTime           @default(now())

  provenance           Provenance?
  mentions             Mention[]
  gapOrigins           IntelligenceGapOrigin[]
  intelligenceResponse IntelligenceResponse?
  normalizedRecords    NormalizedSourceRecord[]

  @@index([caseId])
  @@map("evidence_records")
}

// One provenance record per evidence item, per Blueprint §9:
// originSource, receivedAt, receivedBy, transformationChain[], parentEvidenceId,
// contentHash, optional integrityAnchorId (integrity module lands in Phase 9).
model Provenance {
  id                  String         @id @default(uuid())
  evidenceRecordId    String         @unique
  evidenceRecord      EvidenceRecord @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)
  originSource        String
  receivedAt          DateTime       @default(now())
  receivedById        String
  receivedBy          User           @relation(fields: [receivedById], references: [id])
  transformationChain Json           @default("[]")
  parentEvidenceId    String?
  contentHash         String
  integrityAnchorId   String?

  @@map("provenance_records")
}

// ─── Document Intelligence (Phase 2) — derived, NOT source of truth ───────
// See docs/architecture/SYSTEM-ARCHITECTURE.md §3: Evidence Store above
// remains authoritative; Mention is "a raw extracted reference before
// resolution" (§12). Entity Resolution (Phase 4) is out of scope here.

enum DocumentProcessingStatus {
  pending
  processing
  completed
  failed
}

enum MentionType {
  person
  phone
  vehicle
  location
  organization
  case_identifier
  date
  money
}

enum ExtractionMethod {
  regex
  llm
}

// One row per extracted mention. `caseId` is denormalized from `document`
// for cheap case-scoped queries/ABAC without an extra join, matching the
// same pattern already used on EvidenceRecord/AuditEvent.
model Mention {
  id               String          @id @default(uuid())
  caseId           String
  case             Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  documentId       String
  document         Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  evidenceRecordId String?
  evidenceRecord   EvidenceRecord? @relation(fields: [evidenceRecordId], references: [id])

  mentionType       MentionType
  text              String
  normalizedText    String?
  confidence        Float
  pageNumber        Int?
  startOffset       Int?
  endOffset         Int?
  extractionMethod  ExtractionMethod         @default(regex)
  extractedAt       DateTime                 @default(now())
  gapOrigins        IntelligenceGapOrigin[]
  normalizedRecords NormalizedSourceRecord[]

  @@index([caseId])
  @@index([documentId])
  @@index([mentionType])
  @@map("mentions")
}

// Phase 3: derived requirements, immutable request scope and synthetic receipts.
// CaseClassification above remains the security classification, not crime type.
enum IntelligenceGapStatus {
  OPEN
  REVIEWED
  DISMISSED
  REQUESTED
  RESOLVED
  STALE
}

enum IntelligencePriority {
  HIGH
  MEDIUM
  LOW
}

enum IntelligenceRequestStatus {
  DRAFT
  SUBMITTED
  PENDING_AUTHORIZATION
  AUTHORIZED
  REJECTED
  DISPATCHED
  RECEIVED
  COMPLETED
  FAILED
}

model CaseContextAnalysis {
  id              String   @id @default(uuid())
  caseId          String   @unique
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseType        String
  contextHash     String
  registryVersion String
  rationale       Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("case_context_analyses")
}

model IntelligenceSource {
  id         String                @id
  department String
  category   String
  permission String
  synthetic  Boolean               @default(true)
  gaps       IntelligenceGap[]
  requests   IntelligenceRequest[]

  @@map("intelligence_sources")
}

model IntelligenceGap {
  id             String                  @id @default(uuid())
  caseId         String
  case           Case                    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseType       String
  ruleId         String
  fingerprint    String
  contextHash    String
  requiredData   String
  targetType     String
  targetEntity   String
  sourceId       String
  source         IntelligenceSource      @relation(fields: [sourceId], references: [id])
  timeFrom       DateTime
  timeTo         DateTime
  purpose        String
  priority       IntelligencePriority
  priorityReason String
  explanation    String
  status         IntelligenceGapStatus   @default(OPEN)
  reviewedById   String?
  reviewedBy     User?                   @relation("GapReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?
  origins        IntelligenceGapOrigin[]
  request        IntelligenceRequest?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([caseId, fingerprint])
  @@unique([id, caseId])
  @@index([caseId, status])
  @@map("intelligence_gaps")
}

model IntelligenceGapOrigin {
  id               String          @id @default(uuid())
  gapId            String
  gap              IntelligenceGap @relation(fields: [gapId], references: [id], onDelete: Cascade)
  documentId       String
  document         Document        @relation(fields: [documentId], references: [id])
  evidenceRecordId String?
  evidenceRecord   EvidenceRecord? @relation(fields: [evidenceRecordId], references: [id])
  mentionId        String?
  mention          Mention?        @relation(fields: [mentionId], references: [id], onDelete: SetNull)
  // Immutable span snapshot preserves lineage when Phase 2 force-replaces mentions.
  snapshot         Json

  @@index([gapId])
  @@map("intelligence_gap_origins")
}

model IntelligenceRequest {
  id            String                     @id @default(uuid())
  caseId        String
  case          Case                       @relation(fields: [caseId], references: [id])
  gapId         String                     @unique
  gap           IntelligenceGap            @relation(fields: [gapId, caseId], references: [id, caseId])
  sourceId      String
  source        IntelligenceSource         @relation(fields: [sourceId], references: [id])
  // Server-created, immutable copy of reviewed scope and evidence references.
  scope         Json
  status        IntelligenceRequestStatus  @default(DRAFT)
  createdById   String
  createdBy     User                       @relation("RequestCreator", fields: [createdById], references: [id])
  authorization IntelligenceAuthorization?
  response      IntelligenceResponse?
  transitions   IntelligenceTransition[]
  failureReason String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@unique([gapId, caseId])
  @@index([caseId, status])
  @@map("intelligence_requests")
}

model IntelligenceAuthorization {
  id             String              @id @default(uuid())
  requestId      String              @unique
  request        IntelligenceRequest @relation(fields: [requestId], references: [id])
  authorizedById String
  authorizedBy   User                @relation(fields: [authorizedById], references: [id])
  approved       Boolean
  reason         String
  createdAt      DateTime            @default(now())

  @@map("intelligence_authorizations")
}

model IntelligenceResponse {
  id                String                   @id @default(uuid())
  requestId         String                   @unique
  request           IntelligenceRequest      @relation(fields: [requestId], references: [id])
  evidenceRecordId  String                   @unique
  evidenceRecord    EvidenceRecord           @relation(fields: [evidenceRecordId], references: [id])
  receiptKey        String                   @unique
  retrievedAt       DateTime                 @default(now())
  normalizedRecords NormalizedSourceRecord[]

  @@map("intelligence_responses")
}

model IntelligenceTransition {
  sequence    Int                        @unique @default(autoincrement())
  id          String                     @id @default(uuid())
  requestId   String
  request     IntelligenceRequest        @relation(fields: [requestId], references: [id])
  actorId     String
  actor       User                       @relation(fields: [actorId], references: [id])
  fromStatus  IntelligenceRequestStatus?
  toStatus    IntelligenceRequestStatus
  eventType   String
  publishedAt DateTime?
  createdAt   DateTime                   @default(now())

  @@index([requestId, createdAt])
  @@map("intelligence_transitions")
}

// Phase 4 is a derived, reversible grouping layer, not authoritative evidence.
// Reuse MentionType: money means an identified financial identifier here, never an amount.
enum NormalizedSourceKind {
  MENTION
  RETURNED_INTELLIGENCE
  CASE_METADATA
}

enum ResolutionStatus {
  UNRESOLVED
  REVIEW_REQUIRED
  AUTO_RESOLVED
  ACCEPTED
  DISTINCT
  REJECTED
}

model NormalizedSourceRecord {
  id               String                @id @default(uuid())
  caseId           String
  case             Case                  @relation(fields: [caseId], references: [id])
  sourceKey        String
  entityType       MentionType
  rawValue         String
  normalizedValue  String
  validIdentifier  Boolean               @default(false)
  sourceKind       NormalizedSourceKind
  sourceId         String?
  department       String?
  documentId       String?
  document         Document?             @relation(fields: [documentId], references: [id])
  evidenceRecordId String?
  evidenceRecord   EvidenceRecord?       @relation(fields: [evidenceRecordId], references: [id])
  mentionId        String?
  mention          Mention?              @relation(fields: [mentionId], references: [id], onDelete: SetNull)
  responseId       String?
  response         IntelligenceResponse? @relation(fields: [responseId], references: [id])
  confidence       Float
  reliabilityTier  ReliabilityTier
  attributes       Json
  identifiers      Json
  sourceLocation   Json
  sourceTimestamp  DateTime
  active           Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  entityLinks      EntitySourceLink[]
  leftCandidates   ResolutionCandidate[] @relation("LeftRecord")
  rightCandidates  ResolutionCandidate[] @relation("RightRecord")

  @@unique([caseId, sourceKey])
  @@unique([id, caseId])
  @@index([caseId, active, entityType, normalizedValue])
  @@map("normalized_source_records")
}

model CanonicalEntity {
  id               String                @id @default(uuid())
  caseId           String
  case             Case                  @relation(fields: [caseId], references: [id])
  entityType       MentionType
  membershipKey    String
  displayLabel     String
  resolutionStatus ResolutionStatus
  confidence       Float
  active           Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  sources          EntitySourceLink[]
  outgoing         DerivedRelationship[] @relation("RelationshipSource")
  incoming         DerivedRelationship[] @relation("RelationshipTarget")

  @@unique([caseId, membershipKey])
  @@unique([id, caseId])
  @@index([caseId, active, entityType])
  @@map("canonical_entities")
}

model EntitySourceLink {
  id        String                 @id @default(uuid())
  caseId    String
  entityId  String
  entity    CanonicalEntity        @relation(fields: [entityId, caseId], references: [id, caseId])
  recordId  String
  record    NormalizedSourceRecord @relation(fields: [recordId, caseId], references: [id, caseId])
  createdAt DateTime               @default(now())

  @@unique([entityId, recordId])
  @@index([caseId, recordId])
  @@map("entity_source_links")
}

model ResolutionCandidate {
  id          String                 @id @default(uuid())
  caseId      String
  case        Case                   @relation(fields: [caseId], references: [id])
  leftId      String
  left        NormalizedSourceRecord @relation("LeftRecord", fields: [leftId, caseId], references: [id, caseId])
  rightId     String
  right       NormalizedSourceRecord @relation("RightRecord", fields: [rightId, caseId], references: [id, caseId])
  score       Float
  signals     Json
  conflicts   Json
  ruleVersion String
  status      ResolutionStatus
  revision    Int                    @default(1)
  active      Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  history     ResolutionHistory[]

  @@unique([caseId, leftId, rightId])
  @@unique([id, caseId])
  @@index([caseId, active, status])
  @@map("resolution_candidates")
}

// Resolution decision history also retains delivery state for the EXISTING event bus.
model ResolutionHistory {
  id             String               @id @default(uuid())
  sequence       Int                  @unique @default(autoincrement())
  caseId         String
  case           Case                 @relation(fields: [caseId], references: [id])
  candidateId    String?
  candidate      ResolutionCandidate? @relation(fields: [candidateId, caseId], references: [id, caseId])
  actorId        String
  actor          User                 @relation(fields: [actorId], references: [id])
  idempotencyKey String?
  eventType      String
  fromStatus     ResolutionStatus?
  toStatus       ResolutionStatus?
  reason         String
  payload        Json
  publishedAt    DateTime?
  createdAt      DateTime             @default(now())

  @@unique([caseId, idempotencyKey])
  @@index([caseId, sequence])
  @@map("resolution_history")
}

// Merged Phase 5+6: evidence-bound derived metadata; Neo4j is rebuildable.
model DerivedRelationship {
  id               String          @id @default(uuid())
  caseId           String
  case             Case            @relation(fields: [caseId], references: [id])
  stableKey        String
  sourceId         String
  source           CanonicalEntity @relation("RelationshipSource", fields: [sourceId, caseId], references: [id, caseId])
  targetId         String
  target           CanonicalEntity @relation("RelationshipTarget", fields: [targetId, caseId], references: [id, caseId])
  type             String
  direction        String          @default("DIRECTED")
  findingKind      String
  confidence       Float
  strength         Float
  occurredAt       DateTime?
  observedAt       DateTime?
  endAt            DateTime?
  sourceSystem     String
  sourceRecordIds  Json
  evidenceRefs     Json
  extractionMethod String
  algorithmVersion String
  attributes       Json
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  signalSupports   SignalSupport[]

  @@unique([caseId, stableKey])
  @@unique([id, caseId])
  @@index([caseId, active, type, occurredAt])
  @@map("derived_relationships")
}

model GraphSyncState {
  caseId       String    @id
  case         Case      @relation(fields: [caseId], references: [id])
  status       String
  sourceDigest String?
  graphDigest  String?
  syncedAt     DateTime?
  error        String?
  updatedAt    DateTime  @updatedAt

  @@map("graph_sync_states")
}

model AnalysisRun {
  id               String             @id @default(uuid())
  caseId           String
  case             Case               @relation(fields: [caseId], references: [id])
  actorId          String
  actor            User               @relation(fields: [actorId], references: [id])
  type             String
  inputDigest      String
  algorithmVersion String
  parameters       Json
  status           String
  startedAt        DateTime           @default(now())
  completedAt      DateTime?
  summary          Json
  error            String?
  signals          AnalyticalSignal[]

  @@unique([id, caseId])
  @@index([caseId, type, startedAt])
  @@map("analysis_runs")
}

model AnalyticalSignal {
  id               String          @id @default(uuid())
  caseId           String
  case             Case            @relation(fields: [caseId], references: [id])
  stableKey        String
  runId            String
  run              AnalysisRun     @relation(fields: [runId, caseId], references: [id, caseId])
  type             String
  findingKind      String          @default("SIGNAL")
  entityIds        Json
  strength         Float
  confidence       Float
  timeFrom         DateTime?
  timeTo           DateTime?
  rule             String
  algorithmVersion String
  parameters       Json
  reason           Json
  evidenceRefs     Json
  status           String          @default("UNREVIEWED")
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  supports         SignalSupport[]

  @@unique([caseId, stableKey])
  @@unique([id, caseId])
  @@index([caseId, active, type])
  @@map("analytical_signals")
}

model SignalSupport {
  caseId         String
  signalId       String
  signal         AnalyticalSignal    @relation(fields: [signalId, caseId], references: [id, caseId])
  relationshipId String
  relationship   DerivedRelationship @relation(fields: [relationshipId, caseId], references: [id, caseId])

  @@id([signalId, relationshipId])
  @@map("signal_supports")
}

model BrainEvent {
  id          String    @id @default(uuid())
  sequence    Int       @unique @default(autoincrement())
  caseId      String
  case        Case      @relation(fields: [caseId], references: [id])
  type        String
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([caseId, sequence])
  @@map("brain_events")
}
