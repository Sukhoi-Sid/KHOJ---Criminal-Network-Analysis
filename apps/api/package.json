{
  "name": "@sih/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx scripts/prepare-test-db.ts && tsx scripts/run-test-files.ts",
    "test:prepare": "tsx scripts/prepare-test-db.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.check.json",
    "demo:phase3": "tsx prisma/demo-phase3.ts",
    "demo:phase4": "tsx prisma/demo-phase4.ts",
    "demo:merged": "tsx prisma/demo-merged.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "@sih/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "neo4j-driver": "^6.2.0",
    "pdf-parse": "^1.1.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/pdf-parse": "^1.1.4",
    "@types/pdfkit": "^0.13.9",
    "@types/supertest": "^6.0.2",
    "pdfkit": "^0.15.0",
    "prisma": "^6.3.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
